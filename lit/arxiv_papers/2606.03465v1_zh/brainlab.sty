% --- Таблицы ---
\newtcolorbox{braintablebox}[2][]{
  enhanced,

  width=#2,
  boxrule=\brain@boxrule,
  arc=\brain@arc,

  colback=boxcolor!15,
  colframe=boxcolor!60!black,

  boxsep=0pt,
  left=\brain@tableleftpad,
  right=\brain@tablerightpad,
  top=\brain@tabletopad,
  bottom=\brain@tablebottompad,

  before upper={\setlength{\linewidth}{\dimexpr
    #2-\brain@tableleftpad-\brain@tablerightpad
    -2\brain@boxrule\relax}},

  #1
}

\titlespacing{\subsection}{0pt}{3pt plus 1pt minus 1pt}{3pt plus 1pt minus 1pt}
\titlespacing{\section}{0pt}{12pt plus 2pt minus 2pt}{6pt plus 1pt minus 1pt}



\newenvironment{braintable}[2][\textwidth]
{
  \begin{table}[htbp]
  \begin{center}
  \begin{braintablebox}{#1}
}
{
  \end{braintablebox}
  \end{center}
  \end{table}
}

% --- Алгоритмы ---
\ifbrain@darkheaders
  \renewenvironment{algorithm}[3][]{%
    \refstepcounter{algorithm}%
    \begin{tcolorbox}[%
      colback=boxcolor!10,
      colframe=braincolor,
      arc=\brain@arc,
      boxrule=\brain@boxrule,
      width=#2,
      left=\brain@algorleftpad, right=\brain@algorrightpad,
      top=\brain@algortopad, bottom=\brain@algorbottompad,
      enhanced jigsaw,
      title={Algorithm~\thealgorithm: #3},
      fonttitle=\bfseries,
      coltitle=white,
      attach boxed title to top left={yshift=-2mm, xshift=4mm},
      boxed title style={colback=braincolor, colframe=braincolor},
      #1
    ]
  }{%
    \end{tcolorbox}%
  }
\else
  \renewenvironment{algorithm}[3][]{%
    \refstepcounter{algorithm}%
    \begin{tcolorbox}[%
      colback=boxcolor!10,
      colframe=braincolor,
      arc=\brain@arc,
      boxrule=\brain@boxrule,
      width=#2,
      left=\brain@algorleftpad, right=\brain@algorrightpad,
      top=\brain@algortopad, bottom=\brain@algorbottompad,
      enhanced jigsaw,
      title={Algorithm~\thealgorithm: #3},
      fonttitle=\bfseries,
      coltitle=black,
      attach boxed title to top left={yshift=-2mm, xshift=4mm},
      boxed title style={colback=boxcolor!15, colframe=braincolor},
      #1
    ]
  }{%
    \end{tcolorbox}%
  }
\fi

% --- Теоремы ---
\ifbrain@darkheaders
  \tcbset{brainstyle/.style={
    colback=boxcolor!15,
    colframe=boxcolor!60!black,
    arc=\brain@arc,
    boxrule=\brain@boxrule,
    left=\brain@titleleftpad, right=\brain@titlerightpad,
    top=\brain@titletopad, bottom=\brain@titlebottompad,
    enhanced jigsaw,
    attach boxed title to top left={yshift=-2mm, xshift=4mm},
    boxed title style={colback=braincolor, colframe=braincolor},
    coltitle=white,
    fonttitle=\bfseries
  }}
\else
  \tcbset{brainstyle/.style={
    colback=boxcolor!15,
    colframe=boxcolor!60!black,
    arc=\brain@arc,
    boxrule=\brain@boxrule,
    left=\brain@titleleftpad, right=\brain@titlerightpad,
    top=\brain@titletopad, bottom=\brain@titlebottompad,
    enhanced jigsaw,
    attach boxed title to top left={yshift=-2mm, xshift=4mm},
    boxed title style={colback=boxcolor!15, colframe=braincolor},
    coltitle=black,
    fonttitle=\bfseries
  }}
\fi

\ExplSyntaxOn

\NewDocumentCommand{\DeclareBrainTcbTheorem}{mm}
{
  \newtheorem{#1}{#2}

  % numbering starts from 1
  \setcounter{#1}{0}

  \RenewDocumentEnvironment{#1}{o O{\columnwidth} +b}
  {
    \refstepcounter{#1}

    \begin{tcolorbox}[
      brainstyle,
      width=##2,
      title={
        #2~\csname the#1\endcsname
        \IfValueT{##1}{\ \textnormal{(##1)}}
      }
    ]

    ##3

    \end{tcolorbox}
  }
  {}
}

\ExplSyntaxOff


\DeclareBrainTcbTheorem{theorem}{定理}
\DeclareBrainTcbTheorem{assumption}{假设}
\DeclareBrainTcbTheorem{definition}{定义}



