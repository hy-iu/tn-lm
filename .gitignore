!lit/arxiv_papers/*_zh/**/*.md
!lit/arxiv_papers/*_zh/**/*.py
!lit/arxiv_papers/*_zh/**/*.bib
!lit/arxiv_papers/*_zh/**/*.sty
!lit/arxiv_papers/*_zh/**/*.bst
!lit/arxiv_papers/*_zh/**/*.cls
!lit/arxiv_papers/*_zh/**/*.json
!lit/arxiv_papers/*_zh/**/*.diff
